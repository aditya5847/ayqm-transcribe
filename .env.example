# Hugging Face token, required only when using --diarize
HF_TOKEN=hf_your_token_here

# Gemini API key, required for trivia extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Google GenAI API key fallback, also supported for trivia extraction
GOOGLE_API_KEY=your_google_api_key_here

# Default transcription settings for macOS CPU stability
AYQM_MODEL=base
AYQM_DEVICE=cpu
AYQM_COMPUTE_TYPE=int8
AYQM_BATCH_SIZE=16

# Optional speaker hints for diarization
AYQM_MIN_SPEAKERS=2
AYQM_MAX_SPEAKERS=3

# Gemini trivia extraction defaults
AYQM_GEMINI_MODEL=gemini-3.1-flash-lite
AYQM_GEMINI_INPUT_PRICE_PER_1M=0.25
AYQM_GEMINI_OUTPUT_PRICE_PER_1M=1.50
